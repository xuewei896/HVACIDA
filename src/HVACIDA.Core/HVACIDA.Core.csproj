<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>HVACIDA.Core</RootNamespace>
    <AssemblyName>HVACIDA.Core</AssemblyName>
    <Version>0.1.0</Version>
    <Description>HVACIDA 领域模型与计算服务(无 Revit 依赖)</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 全国省市气象参数库(GB 50736-2012 附录A):生成物,内嵌进 DLL,免外部文件与联网。
         重新生成:python tools\weatherdb\build_weather_db.py
         一致性门禁:tools\weatherdb\check-weather-db-sync.ps1 -->
    <EmbeddedResource Include="Resources\weather-db.csv" />
  </ItemGroup>

  <ItemGroup>
    <!-- Excel(.xlsx)导出用的最小写入器:XLSX 就是 ZIP + XML 部件,.NET Framework 自带的 ZipArchive 即可,
         故不引任何 NuGet(与"不引 netstandard 桥接"的基线一致)。 -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- AI 密钥保险箱:Windows DPAPI(ProtectedData)在 System.Security 里 -->
    <Reference Include="System.Security" />
  </ItemGroup>

</Project>
