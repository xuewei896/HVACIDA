<Window x:Class="HVACIDA.UI.Views.ProjectInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工程信息 - HVACIDA"
        Width="940" Height="580" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Width" Value="185"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,3,2,3"/>
        </Style>
        <Style x:Key="FieldInput" TargetType="{x:Type TextBox}">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,3,10,3"/>
        </Style>
        <Style x:Key="GroupHeader" TargetType="{x:Type GroupBox}">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="8,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="取 消" Width="96" Height="30" IsCancel="True"/>
                <Button x:Name="ConfirmButton" DockPanel.Dock="Right" Content="确 定" Width="100" Height="30" Margin="0,0,8,0"
                        Click="OnConfirmClick" IsDefault="True"
                        ToolTip="保存工程信息并关闭本窗;保存失败时不关窗,状态栏给出原因"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="4,0,12,0"
                           TextTrimming="CharacterEllipsis" Foreground="#2E7D32"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <GroupBox Header="一、工程基本信息" Style="{StaticResource GroupHeader}" ToolTip="需求 2.1.1">
                    <UniformGrid Columns="2">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="工程名称"/><TextBox Width="250" Height="24" VerticalAlignment="Center" Margin="2,3,10,3" Text="{Binding Model.Basic.ProjectName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="设计阶段"/><ComboBox Width="150" Height="24" VerticalAlignment="Center" Margin="2,3,10,3" ItemsSource="{Binding StageOptions}" SelectedItem="{Binding Model.Basic.DesignStage}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="项目地点-省 / 直辖市 / 自治区"/><ComboBox Width="150" Height="24" VerticalAlignment="Center" Margin="2,3,10,3"
                                  ItemsSource="{Binding Provinces}" SelectedItem="{Binding SelectedProvince}"
                                  ToolTip="来源:内嵌气象数据库(GB 50736-2012 附录A,294 个台站)"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="项目地点-市 / 区 / 自治州"/><ComboBox Width="150" Height="24" VerticalAlignment="Center" Margin="2,3,10,3"
                                  ItemsSource="{Binding Cities}" SelectedItem="{Binding SelectedCity}"
                                  IsEnabled="{Binding HasCities}"
                                  ToolTip="选定城市后自动把该市室外气象参数写入本工程"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="项目地点-区 / 县" ToolTip="手工填写"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Basic.LocationDistrict, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="车站名称"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Basic.StationName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="备注"/><TextBox Width="250" Height="24" VerticalAlignment="Center" Margin="2,3,10,3" Text="{Binding Model.Basic.Remark, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    </UniformGrid>
                </GroupBox>

                <GroupBox Header="二、数据导入与存储" Style="{StaticResource GroupHeader}" ToolTip="需求 2.1.3:Excel 模板导入待实现;保存后写入本机存储目录">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="当前存储目录"/>
                        <TextBox Width="440" Height="24" IsReadOnly="True" Background="#F5F5F5"
                                 Text="{Binding StorageDirectory, Mode=OneWay}"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
