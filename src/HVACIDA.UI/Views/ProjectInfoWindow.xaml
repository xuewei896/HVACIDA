<Window x:Class="HVACIDA.UI.Views.ProjectInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工程信息 - HVACIDA"
        Width="940" Height="380" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Width" Value="178"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,2,2,2"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="FieldInput" TargetType="{x:Type TextBox}">
            <Setter Property="Width" Value="240"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,2,10,2"/>
        </Style>
        <Style x:Key="FieldCombo" TargetType="{x:Type ComboBox}">
            <Setter Property="Width" Value="240"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,2,10,2"/>
        </Style>
        <Style x:Key="Card" TargetType="{x:Type Border}">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="CardHeader" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="8,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="取 消" Width="96" Height="30" IsCancel="True"/>
                <Button x:Name="ConfirmButton" DockPanel.Dock="Right" Content="确 定" Width="100" Height="30" Margin="0,0,8,0"
                        Click="OnConfirmClick" IsDefault="True"
                        ToolTip="保存工程信息并关闭本窗;保存失败时不关窗,状态栏给出原因"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="4,0,12,0"
                           TextTrimming="CharacterEllipsis" Foreground="#2E7D32"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
            <StackPanel>

                <!-- ================= 分区一:工程基本信息 ================= -->
                <Border Style="{StaticResource Card}" BorderBrush="#C9DCF2" Background="#FBFDFF"
                        ToolTip="需求 2.1.1;项目地点为省 / 市级联下拉,选定城市即自动回填该市室外气象参数">
                    <StackPanel>
                        <Border Style="{StaticResource CardHeader}" Background="#E3EEFB">
                            <TextBlock Style="{StaticResource CardTitle}" Text="一、工程基本信息" Foreground="#1B4E8A"/>
                        </Border>
                        <StackPanel Margin="8,4,8,8">
                            <UniformGrid Columns="2">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="工程名称"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Basic.ProjectName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="设计阶段"/><ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding StageOptions}" SelectedItem="{Binding Model.Basic.DesignStage}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="项目地点-省" ToolTip="省 / 直辖市 / 自治区"/><ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding Provinces}" SelectedItem="{Binding SelectedProvince}"
                                          ToolTip="来源:内嵌气象数据库(GB 50736-2012 附录A,294 个台站)"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="项目地点-市" ToolTip="市 / 区 / 自治州"/><ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding Cities}" SelectedItem="{Binding SelectedCity}"
                                          IsEnabled="{Binding HasCities}"
                                          ToolTip="选定城市后自动把该市室外气象参数写入本工程"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="项目地点-区 / 县" ToolTip="手工填写"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Basic.LocationDistrict, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="车站名称"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Basic.StationName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="备注"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Basic.Remark, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================= 分区二:数据导入与存储 ================= -->
                <Border Style="{StaticResource Card}" BorderBrush="#D5DBE2" Background="#FBFBFC"
                        ToolTip="需求 2.1.3:Excel 模板导入待实现;保存后写入本机存储目录">
                    <StackPanel>
                        <Border Style="{StaticResource CardHeader}" Background="#ECEFF3">
                            <TextBlock Style="{StaticResource CardTitle}" Text="二、数据导入与存储" Foreground="#3C4858"/>
                        </Border>
                        <StackPanel Margin="8,4,8,8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabel}" Text="当前存储目录"/>
                                <TextBox Height="24" IsReadOnly="True" Background="#F5F5F5"
                                         VerticalAlignment="Center" Margin="2,2,10,2"
                                         Text="{Binding StorageDirectory, Mode=OneWay}"/>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
