<Window x:Class="HVACIDA.UI.Views.ProjectInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="项目信息与气象参数 - HVACIDA"
        Width="980" Height="760"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Width" Value="185"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,3,2,3"/>
        </Style>
        <Style x:Key="FieldInput" TargetType="{x:Type TextBox}">
            <Setter Property="Width" Value="150"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,3,10,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style x:Key="GroupHeader" TargetType="{x:Type GroupBox}">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#E8F0FE" Padding="8,6">
            <TextBlock Text="维护工程基本信息与室内外气象参数(需求文档 2.1)。点击【保存】写入 %AppData%\HVACIDA\project.xml;SQLite 存储后续按同一 IDataRepository 接口替换。"
                       TextWrapping="Wrap"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="8,6">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="保 存" Width="100" Height="30"
                        Command="{Binding SaveCommand}" IsDefault="True"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" Foreground="#2E7D32"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <GroupBox Header="工程基本信息(2.1.1)" Style="{StaticResource GroupHeader}">
                    <UniformGrid Columns="2">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="工程名称"/><TextBox Width="250" VerticalAlignment="Center" Margin="2,3,10,3" Text="{Binding Model.Basic.ProjectName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="设计阶段"/><ComboBox Width="150" VerticalAlignment="Center" Margin="2,3,10,3" ItemsSource="{Binding StageOptions}" SelectedItem="{Binding Model.Basic.DesignStage}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="项目地点-省"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Basic.LocationProvince, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="项目地点-市"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Basic.LocationCity, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="项目地点-区/县"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Basic.LocationDistrict, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="车站编号"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Basic.StationNumber, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="备注"/><TextBox Width="250" VerticalAlignment="Center" Margin="2,3,10,3" Text="{Binding Model.Basic.Remark, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    </UniformGrid>
                </GroupBox>

                <GroupBox Header="大系统室外计算参数(2.1.2,单位 ℃)" Style="{StaticResource GroupHeader}">
                    <UniformGrid Columns="2">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="夏季空调干球温度"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Design.LargeSystemOutdoor.SummerACDryBulbC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="夏季空调湿球温度"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Design.LargeSystemOutdoor.SummerACWetBulbC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="夏季通风计算温度"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Design.LargeSystemOutdoor.SummerVentDryBulbC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="冬季通风计算温度"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Design.LargeSystemOutdoor.WinterVentDryBulbC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="冬季空调计算温度"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Design.LargeSystemOutdoor.WinterACDryBulbC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="大气压力 kPa"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Design.Common.AtmosphericPressureKPa, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="室外相对湿度 %"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Design.Common.OutdoorRelativeHumidityPercent, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    </UniformGrid>
                </GroupBox>

                <GroupBox Header="大系统室内设计参数(站厅/站台)" Style="{StaticResource GroupHeader}">
                    <UniformGrid Columns="2">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅计算干球温度 ℃"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Design.LargeSystemIndoor.HallDryBulbC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅计算相对湿度 %"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Design.LargeSystemIndoor.HallRelativeHumidityPercent, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台计算干球温度 ℃"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Design.LargeSystemIndoor.PlatformDryBulbC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台计算相对湿度 %"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Design.LargeSystemIndoor.PlatformRelativeHumidityPercent, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    </UniformGrid>
                </GroupBox>

                <GroupBox Header="小系统室内设计参数(管理/设备用房)" Style="{StaticResource GroupHeader}">
                    <UniformGrid Columns="2">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="管理用房干球温度 ℃"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Design.SmallSystemIndoor.ManagementRoomDryBulbC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="弱电用房干球温度 ℃"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Design.SmallSystemIndoor.WeakCurrentRoomDryBulbC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="强电用房干球温度 ℃"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Design.SmallSystemIndoor.StrongCurrentRoomDryBulbC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="室内计算湿球温度 ℃"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Design.SmallSystemIndoor.IndoorWetBulbC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="室内计算相对湿度 %"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Design.SmallSystemIndoor.IndoorRelativeHumidityPercent, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    </UniformGrid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
