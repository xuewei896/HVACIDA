<Window x:Class="HVACIDA.UI.Views.ProjectInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工程信息 - HVACIDA"
        Width="940" Height="580" MinWidth="800" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Width" Value="185"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,3,2,3"/>
        </Style>
        <Style x:Key="FieldInput" TargetType="{x:Type TextBox}">
            <Setter Property="Width" Value="150"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,3,10,3"/>
        </Style>
        <Style x:Key="GroupHeader" TargetType="{x:Type GroupBox}">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#E8F0FE" Padding="8,6">
            <TextBlock TextWrapping="Wrap"
                       Text="工程基本信息(需求 2.1.1)。项目地点为「省 / 市」下拉,数据源 = 内嵌气象数据库(GB 50736-2012 附录A,294 个台站);选定城市即自动把该市室外气象参数写入本工程。保存后写入 %AppData%\HVACIDA\project.xml;正式版按需求 2.1.3 以全局参数写入当前 .rvt。室内设计参数见 Ribbon「项目信息 → 气象参数」。"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="8,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="取 消" Width="96" Height="30" IsCancel="True"/>
                <Button DockPanel.Dock="Right" Content="保 存" Width="100" Height="30" Margin="0,0,8,0"
                        Command="{Binding SaveCommand}" IsDefault="True"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" Foreground="#2E7D32"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <GroupBox Header="一、工程基本信息(2.1.1)" Style="{StaticResource GroupHeader}">
                  <StackPanel>
                    <UniformGrid Columns="2">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="工程名称"/><TextBox Width="250" VerticalAlignment="Center" Margin="2,3,10,3" Text="{Binding Model.Basic.ProjectName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="设计阶段"/><ComboBox Width="150" VerticalAlignment="Center" Margin="2,3,10,3" ItemsSource="{Binding StageOptions}" SelectedItem="{Binding Model.Basic.DesignStage}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="项目地点-省 / 直辖市 / 自治区"/><ComboBox Width="150" VerticalAlignment="Center" Margin="2,3,10,3"
                                  ItemsSource="{Binding Provinces}" SelectedItem="{Binding SelectedProvince}"
                                  ToolTip="来自内嵌气象库(GB 50736-2012 附录A,294 个台站)的省级行政区;选省后再选市"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="项目地点-市 / 区 / 自治州"/><ComboBox Width="150" VerticalAlignment="Center" Margin="2,3,10,3"
                                  ItemsSource="{Binding Cities}" SelectedItem="{Binding SelectedCity}"
                                  IsEnabled="{Binding HasCities}"
                                  ToolTip="选定城市后自动把该市室外气象参数写入本工程(数据源 GB 50736-2012 附录A)"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="项目地点-区 / 县(手工填)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Basic.LocationDistrict, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="车站名称"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Model.Basic.StationName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="备注"/><TextBox Width="250" VerticalAlignment="Center" Margin="2,3,10,3" Text="{Binding Model.Basic.Remark, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    </UniformGrid>

                    <Border Margin="2,8,2,0" Padding="8,6" Background="#F3F7FD" BorderBrush="#D6E2F0" BorderThickness="1"
                            Visibility="{Binding StationInfoVisibility}">
                        <StackPanel>
                            <TextBlock Text="{Binding StationInfo}" TextWrapping="Wrap" Foreground="#23486E"/>
                            <TextBlock Text="↓ 选定城市后自动回填到本工程的室外气象参数" Margin="0,5,0,2" Foreground="#5A5A5A"/>
                            <TextBlock Text="{Binding WeatherSummary}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                            <TextBlock Text="{Binding WeatherWarning}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#C0392B"
                                       Visibility="{Binding WeatherWarningVisibility}"/>
                        </StackPanel>
                    </Border>
                  </StackPanel>
                </GroupBox>

                <GroupBox Header="二、数据导入与存储(2.1.3)" Style="{StaticResource GroupHeader}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="2,2,2,6"
                                   Text="· Excel 模板导入:模板字段与 2.1.1 / 2.1.2 完全一致,由插件生成(待实现)。"/>
                        <TextBlock TextWrapping="Wrap" Margin="2,2,2,6"
                                   Text="· .rvt 全局参数:正式版点「确定」后以全局参数写入当前工程文件,作为模型元数据随文件流转。"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="当前存储目录"/>
                            <TextBox Width="440" IsReadOnly="True" Background="#F5F5F5"
                                     Text="{Binding StorageDirectory, Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
