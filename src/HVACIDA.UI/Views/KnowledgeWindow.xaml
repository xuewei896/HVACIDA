<Window x:Class="HVACIDA.UI.Views.KnowledgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="规范知识库 - HVACIDA"
        Width="880" Height="620" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#E8F0FE" Padding="8,6">
            <TextBlock TextWrapping="Wrap"
                       Text="设计口径问答(需求 2.7)。当前为本地规则应答,只覆盖本项目已定口径,不替代规范原文;正式版接入 AI 服务与规范全文检索(需求 4.1)。"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="8,6">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="清空对话" Width="96" Height="30"
                        Command="{Binding ResetCommand}"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" Foreground="#2E7D32"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#D7D7D7" BorderThickness="0,0,0,1"
                Padding="8,6">
            <ItemsControl ItemsSource="{Binding SampleQuestions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" Margin="0,0,6,6" Padding="8,3" Click="OnSampleClick"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="8,8,8,4">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="提 问" Width="90" Height="30" Margin="8,0,0,0"
                        Command="{Binding AskCommand}" IsDefault="True"/>
                <TextBox Height="30" VerticalContentAlignment="Center" Padding="6,0"
                         Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnQuestionKeyDown"/>
            </DockPanel>
        </Border>

        <ListBox ItemsSource="{Binding Lines}" BorderThickness="0" Background="White"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Setter Property="Focusable" Value="False"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8,6" Margin="8,3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F5F5F5"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter Property="Background" Value="#DCEBF9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Margin="0,0,0,2">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="HVACIDA 知识库"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter Property="Text" Value="我"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
