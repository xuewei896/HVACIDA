<Window x:Class="HVACIDA.UI.Views.LargeSystemResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HVACIDA.UI.Views"
        Title="大系统 — 计算结果 - HVACIDA"
        Width="1040" Height="580" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="8,6">
            <DockPanel>
                <Button Content="计 算" Width="100" Height="30" DockPanel.Dock="Left"
                        Command="{Binding CalculateCommand}" IsDefault="True"
                        ToolTip="重新读取已保存的参数并计算(本窗打开时已自动算过一次;点它用于别处又改了参数后刷新)"/>
                <Button Content="导出计算书" Width="110" Height="30" Margin="8,0,0,0" DockPanel.Dock="Left"
                        Click="OnExportClick"
                        ToolTip="弹「另存为」对话框选保存位置,导出后自动打开:.xlsx = 排版好的完整计算书(计算参数与选型 / 输入参数 / 负荷汇总 / 排烟分区 / 排烟选型 / 口径与待补),.txt = 文本计算书"/>
                <Button DockPanel.Dock="Right" Content="取 消" Width="96" Height="30" IsCancel="True"/>
                <Button x:Name="ConfirmButton" DockPanel.Dock="Right" Content="确 定" Width="100" Height="30" Margin="0,0,8,0"
                        Click="OnConfirmClick"
                        ToolTip="关闭本窗(本窗只读展示,不写盘)"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,12,0"
                           TextTrimming="CharacterEllipsis" Foreground="#2E7D32"/>
            </DockPanel>
        </Border>

        <!-- 固定尺寸窗:页面主体就是两段(一、计算参数 / 二、选型参数);逐区域与逐分区明细、文本计算书在其它窗(§4.2d) -->
        <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" Padding="10">
            <views:ResultTableView x:Name="SummaryTableHost" Table="{Binding SummaryTable}"/>
        </ScrollViewer>
    </DockPanel>
</Window>
