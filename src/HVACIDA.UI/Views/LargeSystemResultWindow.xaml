<Window x:Class="HVACIDA.UI.Views.LargeSystemResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大系统 — 计算结果 - HVACIDA"
        Width="1040" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="ResultGrid" TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#DDDDDD"/>
            <Setter Property="VerticalGridLinesBrush" Value="#DDDDDD"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowHeight" Value="24"/>
            <Setter Property="ColumnHeaderHeight" Value="28"/>
        </Style>
        <Style x:Key="NumCell" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,8,0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style x:Key="TextCell" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,4,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#E8F0FE" Padding="8,6">
            <TextBlock TextWrapping="Wrap"
                       Text="读取「公共区参数 / 负荷计算 / 排烟计算」保存的参数后计算结果(需求 2.2.3.1)。负荷计算书口径与《大系统负荷计算公式.docx》一致(北京站算例 30 项逐格核对);排烟结果见下表。"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="8,6">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="计 算" Width="100" Height="30"
                        Command="{Binding CalculateCommand}" IsDefault="True"/>
                <Button DockPanel.Dock="Left" Content="导出计算书" Width="110" Height="30" Margin="8,0,0,0"
                        Command="{Binding ExportCommand}"/>
                <Button DockPanel.Dock="Right" Content="关 闭" Width="96" Height="30" IsCancel="True"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" Foreground="#2E7D32"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="10,8,0,4" FontWeight="Bold"
                       Text="一、排烟计算结果(表格;高亮行为风机选型基准区)"/>

            <DataGrid x:Name="SmokeGrid" Grid.Row="1" Margin="10,0,10,0" Style="{StaticResource ResultGrid}"
                      ItemsSource="{Binding SmokeRows}" SelectionMode="Single" AlternatingRowBackground="#F7FAFD">
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGoverning}" Value="True">
                                <Setter Property="Background" Value="#FFF4E5"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="ToolTip" Value="风机选型基准区(站厅/站台计算排烟量的较大者)"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="区域" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBlock Style="{StaticResource TextCell}" Text="{Binding ZoneName}"/></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="面积 m²" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBlock Style="{StaticResource NumCell}" Text="{Binding AreaM2, StringFormat={}{0:N1}}"/></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="计算排烟量 m³/h" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBlock Style="{StaticResource NumCell}" Text="{Binding CalculatedFlowM3H, StringFormat={}{0:N1}}"/></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="选型排烟量 m³/h" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBlock Style="{StaticResource NumCell}" Text="{Binding SelectionFlowM3H, StringFormat={}{0:N1}}"/></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="单台风机风量 m³/h" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBlock Style="{StaticResource NumCell}" Text="{Binding UnitFlowM3H, StringFormat={}{0:N1}}"/></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2" Margin="10,6,10,0">
                <TextBlock Text="{Binding SmokeSummary}" FontWeight="Bold" Foreground="#23486E" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SmokeNote}" Foreground="#8A6100" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Margin="10,10,0,4" FontWeight="Bold" Text="二、大系统负荷计算书(全文)"/>

            <TextBox Grid.Row="4" Margin="10,0,10,10" Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12"
                     Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" Padding="8"/>
        </Grid>
    </DockPanel>
</Window>
