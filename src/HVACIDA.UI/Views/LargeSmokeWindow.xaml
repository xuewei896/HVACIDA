<Window x:Class="HVACIDA.UI.Views.LargeSmokeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大系统 — 排烟计算 - HVACIDA"
        Width="1020" Height="680" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Width" Value="168"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,3,2,3"/>
        </Style>
        <Style x:Key="FieldInput" TargetType="{x:Type TextBox}">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,3,10,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <!-- 表格:结果以表格形式呈现,数值列右对齐、整列网格线 -->
        <Style x:Key="ResultGrid" TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#DDDDDD"/>
            <Setter Property="VerticalGridLinesBrush" Value="#DDDDDD"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowHeight" Value="24"/>
            <Setter Property="ColumnHeaderHeight" Value="28"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="NumCell" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,8,0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style x:Key="TextCell" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,4,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 顶部口径提示:已定口径 + 过渡口径必须同时可见 -->
        <Border DockPanel.Dock="Top" Background="#FFF4E5" Padding="8,6"
                ToolTip="计算排烟量 = 公共区面积 × 60 m³/(h·m²);选型排烟量 = 计算排烟量 × 1.2;排烟风机 2 台,取站厅/站台大者">
            <TextBlock Text="{Binding PendingNote}" TextWrapping="Wrap" Foreground="#C0392B"/>
        </Border>

        <!-- 底部操作区 -->
        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="计 算" Width="90" Height="30" Margin="0,0,8,0"
                            Command="{Binding CalculateCommand}" IsDefault="True"
                            ToolTip="计算并把排烟参数保存到 large-smoke.xml(「大系统 → 计算结果」窗里的排烟表读的就是这份参数)"/>
                    <Button Content="重取面积" Width="96" Height="30" Click="OnReloadAreasClick"
                            ToolTip="从「大系统 → 公共区参数」重新读取 D55/D56 并重算"/>
                    <Button Content="保 存 参 数" Width="110" Height="30" Margin="8,0,0,0"
                            Command="{Binding SaveCommand}"/>
                    <Button Content="导出计算书" Width="110" Height="30" Margin="8,0,0,0"
                            Command="{Binding ExportCommand}"/>
                    <Button Content="导出 Excel" Width="104" Height="30" Margin="8,0,0,0"
                            Command="{Binding ExportExcelCommand}"
                            ToolTip="导出 .xlsx:排烟分区(逐区域宽表)+ 排烟选型 + 口径与待补"/>
                    <Button Content="恢复默认" Width="96" Height="30" Margin="8,0,0,0"
                            Command="{Binding ResetCommand}"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="关 闭" Width="90" Height="30" IsCancel="True"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" Foreground="#2E7D32"/>
            </DockPanel>
        </Border>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 一、计算参数 -->
            <GroupBox Grid.Row="0" Header="一、计算参数" Padding="6" Margin="0,0,0,8"
                      ToolTip="需求 2.2.3.1;面积来自「公共区参数」,只读">
                <StackPanel>
                    <TextBlock Text="{Binding AreaSourceText}" Foreground="#5A5A5A" TextWrapping="Wrap" Margin="6,0,6,4"/>
                    <UniformGrid Columns="3">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="单位面积排烟量 m³/(h·m²)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.SmokeRateM3HPerM2, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="选型系数(计算 × …)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.SelectionFactor, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="排烟风机台数"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.FanUnitCount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    </UniformGrid>
                </StackPanel>
            </GroupBox>

            <!-- 二、计算结果表 -->
            <TextBlock Grid.Row="1" Margin="4,0,0,4" FontWeight="Bold" Foreground="#23486E"
                       Text="二、排烟计算结果"
                       ToolTip="数值列右对齐;选中行的区域为风机选型基准"/>

            <DataGrid x:Name="SmokeGrid" Grid.Row="2" Style="{StaticResource ResultGrid}" ItemsSource="{Binding Rows}"
                      SelectionMode="Single" AlternatingRowBackground="#F7FAFD">
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGoverning}" Value="True">
                                <Setter Property="Background" Value="#FFF4E5"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="ToolTip" Value="风机选型基准区(站厅/站台计算排烟量的较大者)"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="区域" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource TextCell}" Text="{Binding ZoneName}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="面积 m²" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource NumCell}" Text="{Binding AreaM2, StringFormat={}{0:N1}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="计算排烟量 m³/h" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource NumCell}" Text="{Binding CalculatedFlowM3H, StringFormat={}{0:N1}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="选型排烟量 m³/h" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource NumCell}" Text="{Binding SelectionFlowM3H, StringFormat={}{0:N1}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="单台风机风量 m³/h" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource NumCell}" Text="{Binding UnitFlowM3H, StringFormat={}{0:N1}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 三、选型结论 + 口径 -->
            <Border Grid.Row="3" Margin="0,8,0,0" Padding="8,6" Background="#F3F7FD"
                    BorderBrush="#D6E2F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="三、风机选型结论" FontWeight="Bold" Foreground="#23486E"/>
                    <TextBlock Text="{Binding SelectionSummary}" TextWrapping="Wrap" Margin="0,4,0,2"/>
                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="#5A5A5A"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
