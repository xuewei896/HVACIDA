<Window x:Class="HVACIDA.UI.Views.SmallSystemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:HVACIDA.Core.Models;assembly=HVACIDA.Core"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="小系统负荷计算 - HVACIDA"
        Width="1120" Height="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True">
    <Window.Resources>
        <ObjectDataProvider x:Key="SystemTypeOptions" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="core:SmallSystemType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Width" Value="175"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,3,2,3"/>
        </Style>
        <Style x:Key="FieldInput" TargetType="{x:Type TextBox}">
            <Setter Property="Width" Value="130"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,3,10,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FFF4E5" Padding="8,6">
            <TextBlock Text="选择系统类型并输入参数后点击【计算】。当前仅完整实现“全空气一次回风系统”;其余类型输出提示后按需求文档 2.2.3.2 逐条实现。"
                       TextWrapping="Wrap" Foreground="#8A6100"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="计 算" Width="90" Height="30" Margin="0,0,8,0"
                            Command="{Binding CalculateCommand}" IsDefault="True"/>
                    <Button Content="导出计算书" Width="110" Height="30"
                            Command="{Binding ExportCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" Foreground="#2E7D32"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="4">
                <StackPanel>
                    <GroupBox Header="系统与空间" Padding="6" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="系统类型"/>
                                <ComboBox Width="180" VerticalAlignment="Center" Margin="2,3,10,3"
                                          ItemsSource="{Binding Source={StaticResource SystemTypeOptions}}"
                                          SelectedItem="{Binding Input.SystemType}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="房间/区域名称"/>
                                <TextBox Width="180" VerticalAlignment="Center" Margin="2,3,10,3"
                                         Text="{Binding Input.RoomName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="房间面积 m²"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.AreaM2, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="房间净高 m"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HeightM, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="外墙总长 m"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.WallLengthM, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="屋面/楼板面积 m²"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.RoofAreaM2, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="温度与负荷指标" Padding="6">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="室内计算温度 ℃"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.IndoorTempC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="室外计算温度 ℃"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.OutdoorTempC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="送风温差 ℃"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.SupplyTempDiffC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="管道温升 ℃"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.DuctTempRiseC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="照明功率密度 W/m²"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.LightingDensityWm2, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="设备发热密度 W/m²"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.EquipmentDensityWm2, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="人员数量 人"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.Occupants, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="人员显热 W/人"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.OccupantSensibleW, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="人员散湿量 g/(h·人)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.WaterVaporPerPersonGPerHour, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="换气次数 次/h"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.AirChangePerHour, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="每人新风量 m³/(h·人)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.FreshAirPerPersonM3H, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="#DDDDDD" ResizeBehavior="PreviousAndNext"/>

            <Border Grid.Column="2" Margin="4" BorderBrush="#DDDDDD" BorderThickness="1" Background="#FAFAFA">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="计算结果" FontWeight="Bold" Padding="8,6" Background="#EFEFEF"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding ResultText}" Padding="10" FontFamily="Consolas"
                                   TextWrapping="Wrap" VerticalAlignment="Top"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
