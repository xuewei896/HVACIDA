<Window x:Class="HVACIDA.UI.Views.SmallSystemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HVACIDA.UI.Views"
        Title="小系统 — 计算 - HVACIDA"
        Width="1200" Height="800" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Width" Value="176"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,2,2,2"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="FieldInput" TargetType="{x:Type TextBox}">
            <Setter Property="Width" Value="86"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,2,10,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <!-- 结果/明细表:数值列右对齐、整列网格线 -->
        <Style x:Key="ResultGrid" TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#DDDDDD"/>
            <Setter Property="VerticalGridLinesBrush" Value="#DDDDDD"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="ColumnHeaderHeight" Value="30"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 顶部提示条:系统名 + 公式来源 + 待补口径(红字,必须可见) -->
        <Border DockPanel.Dock="Top" Background="#FFF4E5" Padding="8,6">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="#8A6100">
                    <Run Text="系统类型:"/><Run Text="{Binding SystemTypeName, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text="   ·   公式来源《小系统空调负荷、送排风、排烟计算公式.docx》(需求 2.2.3.2)"/>
                    <Run Text="   ·   一个系统可录入多个房间 / 防烟分区,结果为「系统结果 + 房间明细 + 设备选型」三张表。"/>
                </TextBlock>
                <TextBlock Text="{Binding PendingNote}" TextWrapping="Wrap" Foreground="#C0392B" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 底部操作栏 -->
        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="计 算" Width="90" Height="30" Margin="0,0,8,0"
                            Command="{Binding CalculateCommand}" IsDefault="True"/>
                    <Button Content="保 存 参 数" Width="104" Height="30"
                            Command="{Binding SaveCommand}"/>
                    <Button Content="导出计算书" Width="104" Height="30" Margin="8,0,0,0"
                            Command="{Binding ExportCommand}"/>
                    <Button Content="恢复默认" Width="92" Height="30" Margin="8,0,0,0"
                            Command="{Binding ResetCommand}"
                            ToolTip="恢复公式文档给定的默认参数(房间列表保留)"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="关 闭" Width="90" Height="30" IsCancel="True"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" Foreground="#2E7D32"/>
            </DockPanel>
        </Border>

        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 一、计算参数(系统级;按系统类型显示适用项) -->
            <GroupBox Grid.Row="0" Header="一、计算参数(系统级;房间参数在录入表逐行填写)" Padding="6" Margin="0,0,0,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="196">
                    <StackPanel>
                        <TextBlock Text="{Binding WeatherNote}" TextWrapping="Wrap" Foreground="#5A5A5A" Margin="6,0,6,4"/>

                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Width="290">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="系统编号"
                                           ToolTip="设备编号,写入设备选型表首列;留空时按系统类型取默认前缀"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.SystemCode, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Width="290">
                                <CheckBox Content="手工输入室外参数(不随项目信息联动)" VerticalAlignment="Center" Margin="6,2,2,2"
                                          IsChecked="{Binding Input.WeatherManuallyOverridden}"
                                          ToolTip="不勾选时,室外干球 / 湿球温度在打开本窗时自动取自「项目信息 → 气象参数」"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowOutdoorParams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="室外计算干球温度 ℃"
                                           ToolTip="夏季空调室外计算干球温度,自动取自「项目信息 → 气象参数」(公式文档单元格 E4)"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.OutdoorDryBulbC, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowOutdoorParams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="室外计算湿球温度 ℃"
                                           ToolTip="夏季空调室外计算湿球温度,自动取自「项目信息 → 气象参数」(公式文档单元格 E5)"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.OutdoorWetBulbC, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowVrfParams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="过渡季通风室外温度 ℃"
                                           ToolTip="多联机+新风系统按过渡季温差算消除余热通风量(公式文档单元格 N8)"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.TransitionOutdoorC, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowIndoorParams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="室内计算干球温度 ℃"
                                           ToolTip="室内设计干球温度(公式文档单元格 E7)"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.IndoorTempC, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowAllAirParams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="送风温差 ℃"
                                           ToolTip="送风温度 = 室内温度 − 送风温差(公式文档单元格 N4)"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.SupplyTempDiffC, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowAllAirParams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="管道温升 ℃"
                                           ToolTip="露点温度 = 送风温度 − 管道温升(公式文档单元格 E9)"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.DuctTempRiseC, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowAllAirParams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="露点相对湿度 %"
                                           ToolTip="露点含湿量按该相对湿度取自饱和线(公式文档单元格 D44)"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.DewPointRhPct, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowVrfParams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="室内相对湿度 %"
                                           ToolTip="多联机+新风的室内状态点含湿量按该相对湿度取(公式文档单元格 C83)"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.IndoorRhPct, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowLoadIndexParams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="照明指标 W/m²"
                                           ToolTip="照明冷负荷 = 照明指标 × 房间面积(公式文档单元格 A21)"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.LightingIndexWm2, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowLoadIndexParams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="壁面产湿量 g/(m²·h)"
                                           ToolTip="结构湿负荷 =(层高×外墙长 + 屋顶面积)× 壁面产湿量(公式文档单元格 A17)"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.WallMoistureEmission, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowLoadIndexParams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="人员冷负荷 W/人"
                                           ToolTip="人员冷负荷 = 该指标 × 房间预测人数(公式文档单元格 J27)"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PersonCoolingW, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowLoadIndexParams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="人员散湿量 g/(h·人)"
                                           ToolTip="人员湿负荷 = 该指标 × 房间预测人数(公式文档单元格 K27)"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PersonMoistureGH, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowLoadIndexParams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="每人新风量 m³/(h·人)"
                                           ToolTip="人员新风量 = 该指标 × 房间预测人数(公式文档单元格 T27)"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.FreshAirPerPersonM3H, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Width="290">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="主设备选型系数"
                                           ToolTip="小于 0 = 按系统类型取公式文档默认值:全空气 1.1、多联机 1.1、排风 1.1、排烟 1.2、送排风 1.1、加压 1.2"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.SelectionFactor, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowSmokeParams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="排烟选型系数"
                                           ToolTip="选型排烟量 = 计算排烟量 × 该系数(默认 1.2)"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.SmokeSelectionFactor, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowSmokeParams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="补风比例"
                                           ToolTip="计算补风量 = 计算排烟量 × 该比例(默认 0.6)"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.MakeupAirRatio, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowSmokeParams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="补风选型系数"
                                           ToolTip="选型补风量 = 计算补风量 × 该系数(默认 1.1)"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.MakeupAirSelectionFactor, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowSupplyFromExhaustRatio, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="送风比例"
                                           ToolTip="计算送风量 = 计算排风量 × 该比例(默认 0.9)"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.SupplyFromExhaustRatio, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowDoorParams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="一层可开启门宽度 m"
                                           ToolTip="公式文档单元格 B388"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.DoorWidthM, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowDoorParams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="一层可开启门高度 m"
                                           ToolTip="公式文档单元格 C388"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.DoorHeightM, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowDoorParams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="门缝隙漏风风速 m/s"
                                           ToolTip="公式文档单元格 E388"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.DoorLeakageVelocityMs, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowDoorParams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="疏散门开启数量 N1"
                                           ToolTip="公式文档单元格 F388"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.OpenDoorCount, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowDoorParams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="漏风疏散门数量 N2"
                                           ToolTip="负担楼层数 − 1(公式文档单元格 M388)"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.LeakDoorCount, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowDoorParams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="余压阀面积 m²"
                                           ToolTip="单个余压阀面积 Af(公式文档单元格 O388)"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.ReliefValveAreaM2, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowDoorParams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="余压阀数量 N3"
                                           ToolTip="公式文档单元格 P388"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.ReliefValveCount, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Width="290" Visibility="{Binding ShowDoorParams, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="计算压力差 Pa"
                                           ToolTip="门缝漏风量按该平均压力差开方计算(公式文档单元格 K388)"/>
                                <TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PressureDiffPa, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <!-- 二、房间 / 分区录入(加压送风无房间行,整块折叠) -->
            <GroupBox Grid.Row="1" Header="二、房间 / 分区录入(换气次数留 0 时按房间类型取默认值)" Padding="6" Margin="0,0,0,8"
                      Visibility="{Binding ShowRoomArea, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="添加行" Width="84" Height="26" Command="{Binding AddRoomCommand}"/>
                        <Button Content="删除行" Width="84" Height="26" Margin="8,0,0,0" Command="{Binding RemoveRoomCommand}"
                                ToolTip="删除录入表中当前选中的房间行"/>
                        <Button x:Name="PickSpacesButton" Content="从模型拾取空间…" Height="26" Margin="8,0,0,0"
                                Click="OnPickSpacesClick" IsEnabled="{Binding IsPickAvailable}"
                                ToolTip="点击后本窗关闭,在模型中依次选择本系统负责的空间(可多选,回车结束);随后自动回到本窗并把这些空间追加为房间行"/>
                        <Button x:Name="PickWallButton" Content="拾取墙体求外墙总长…" Height="26" Margin="8,0,0,0"
                                Click="OnPickWallClick" IsEnabled="{Binding IsPickAvailable}"
                                ToolTip="先在房间表中选中一行,再点击本按钮;在模型中选取与该房间接触的多段外墙,自动取其长度之和填入该行的与土壤接触外墙长度"/>
                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#5A5A5A"
                                   TextTrimming="CharacterEllipsis"
                                   Text="房间类型可填「卫生间 / 淋浴间 / 环控机房 / 气瓶间 / 电缆引入间 / 泵房」等;送排风排烟系统的「参与送/排烟/补风」勾选环控机房行。"/>
                    </StackPanel>
                    <DataGrid x:Name="InputGrid" Height="152"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" CanUserSortColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#DDDDDD" VerticalGridLinesBrush="#DDDDDD"
                              Background="White" RowHeight="26" ColumnHeaderHeight="30"
                              AlternatingRowBackground="#F7FAFD" SelectionMode="Single"
                              ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}"/>
                </DockPanel>
            </GroupBox>

            <!-- 三、结果:系统结果表 + 房间明细 + 设备选型 + 口径说明 -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="130"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="96"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Margin="4,0,0,4" FontWeight="Bold"
                           Text="三、计算结果(系统结果 · 与导出的计算书同源)"/>
                <Border Grid.Row="1" Margin="0,0,0,2" BorderBrush="#DDDDDD" BorderThickness="1" Background="#FAFAFA" Padding="2">
                    <views:ResultTableView x:Name="ResultTableHost" Table="{Binding Table}"/>
                </Border>

                <TextBlock Grid.Row="2" Margin="4,6,0,4" FontWeight="Bold"
                           Text="房间 / 分区明细(列与计算书同源,按系统类型取舍)"/>
                <DataGrid Grid.Row="3" x:Name="RoomDetailGrid" Style="{StaticResource ResultGrid}"
                          ItemsSource="{Binding RoomRows}" AlternatingRowBackground="#F7FAFD"
                          HorizontalScrollBarVisibility="Auto"/>

                <TextBlock Grid.Row="4" Margin="4,6,0,4" FontWeight="Bold"
                           Text="设备编号及选型(系数 / 风量 m³/h / 冷量 kW)"/>
                <DataGrid Grid.Row="5" x:Name="EquipmentGrid" Style="{StaticResource ResultGrid}"
                          MaxHeight="132" ItemsSource="{Binding EquipmentRows}" AlternatingRowBackground="#F7FAFD">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="系统代码" Width="150" Binding="{Binding Code}"/>
                        <DataGridTextColumn Header="设备" Width="180" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="系数" Width="90" Binding="{Binding Factor, StringFormat={}{0:N2}}"/>
                        <DataGridTextColumn Header="风量 m³/h" Width="140" Binding="{Binding FlowM3H, StringFormat={}{0:N0}}"/>
                        <DataGridTemplateColumn Header="冷量 kW" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- 通风类设备无冷量,显示破折号 -->
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,8,0" FontFamily="Consolas">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Text" Value="{Binding CoolingKw, StringFormat={}{0:N2}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCooling}" Value="False">
                                                        <Setter Property="Text" Value="—"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="6" Margin="0,8,0,0" Padding="8,6" Background="#F3F7FD"
                        BorderBrush="#D6E2F0" BorderThickness="1">
                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="#5A5A5A"/>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
