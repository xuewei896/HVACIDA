<Window x:Class="HVACIDA.UI.Views.HydraulicResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HVACIDA.UI.Views"
        Title="水力计算 — 计算结果 - HVACIDA"
        Width="1300" Height="880" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Grid" TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#DDDDDD"/>
            <Setter Property="VerticalGridLinesBrush" Value="#DDDDDD"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowHeight" Value="24"/>
            <Setter Property="ColumnHeaderHeight" Value="28"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4,6,0,4"/>
            <Setter Property="Foreground" Value="#23486E"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#E8F0FE" Padding="8,6">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="#23486E">
                    <Run Text="水力计算全站汇总(逐系统一行):"/><Run Text="{Binding SummaryTitle, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text="   ·   数据源 hydraulic.xml;打开即算 —— 每套系统各自算,汇总只相加可加量(压力不可加)"/>
                </TextBlock>
                <TextBlock Text="{Binding PendingNote}" TextWrapping="Wrap" Foreground="#C0392B" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="计 算" Width="90" Height="30" Command="{Binding CalculateCommand}" IsDefault="True"
                            ToolTip="重新读取 hydraulic.xml 里的全部系统并逐系统现算(本窗打开时已自动算过一次)"/>
                    <Button Content="导出计算书" Width="110" Height="30" Margin="8,0,0,0" Command="{Binding ExportCommand}"
                            ToolTip="导出**选中系统**的文本计算书(汇总 + 逐段明细 + 阻力项 + 并联平衡 + 特性曲线 + 取值)"/>
                    <Button Content="导出全站 Excel" Width="126" Height="30" Margin="8,0,0,0" Command="{Binding ExportExcelCommand}"
                            ToolTip="导出全站汇总 .xlsx:全站汇总 / 逐系统 / 取值与口径 + 各系统的管段与并联平衡明细页"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="关 闭" Width="90" Height="30" IsCancel="True"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" Foreground="#2E7D32"/>
            </DockPanel>
        </Border>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.1*" MinHeight="110"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.0*" MinHeight="110"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="0.9*" MinHeight="96"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="0.7*" MinHeight="80"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="0.8*" MinHeight="92"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 一、汇总表(逐系统一行) -->
            <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" Margin="4,0,0,4"
                       Text="一、全站汇总(逐系统一行;「—」= 该系统不涉及该项,点某一行看逐段明细)"/>
            <DataGrid Grid.Row="1" x:Name="SummaryGrid" Style="{StaticResource Grid}"
                      ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      SelectionMode="Single" AlternatingRowBackground="#F7FAFD" HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="介质" Width="76" Binding="{Binding KindName}"/>
                    <DataGridTextColumn Header="系统编号" Width="120" Binding="{Binding SystemCode}"/>
                    <DataGridTextColumn Header="系统名称" Width="150" Binding="{Binding SystemName}"/>
                    <DataGridTextColumn Header="最不利环路末端" Width="160" Binding="{Binding CriticalPathName}"/>
                    <DataGridTextColumn Header="环路段数 / 总段数" Width="126" Binding="{Binding SegmentText}"/>
                    <DataGridTextColumn Header="管段总长" Width="100" Binding="{Binding LengthText}"/>
                    <DataGridTextColumn Header="设计流量" Width="110" Binding="{Binding FlowText}"/>
                    <DataGridTextColumn Header="沿程 Pa" Width="96" Binding="{Binding FrictionText}"/>
                    <DataGridTextColumn Header="局部 Pa" Width="96" Binding="{Binding LocalText}"/>
                    <DataGridTextColumn Header="末端+设备 Pa" Width="118" Binding="{Binding EquipmentText}"/>
                    <DataGridTextColumn Header="出口动压 Pa" Width="106" Binding="{Binding OutletText}"/>
                    <DataGridTextColumn Header="静压 Pa" Width="96" Binding="{Binding StaticText}"/>
                    <DataGridTextColumn Header="计算总阻力" Width="110" Binding="{Binding TotalText}"/>
                    <DataGridTextColumn Header="需求值" Width="118" Binding="{Binding RequiredText}"/>
                    <DataGridTextColumn Header="设备额定值" Width="118" Binding="{Binding RatedText}"/>
                    <DataGridTextColumn Header="余量" Width="84" Binding="{Binding MarginText}"/>
                    <DataGridTextColumn Header="并联支路" Width="90" Binding="{Binding BranchText}"/>
                    <DataGridTextColumn Header="最大不平衡率" Width="116" Binding="{Binding ImbalanceText}"/>
                    <DataGridTextColumn Header="超限支路" Width="90" Binding="{Binding UnbalancedText}"/>
                    <DataGridTextColumn Header="校核结论" Width="*" Binding="{Binding VerdictText}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 二、汇总指标表 -->
            <TextBlock Grid.Row="2" Style="{StaticResource SectionTitle}"
                       Text="二、选中介质的汇总指标(与导出的计算书同源)"/>
            <views:ResultTableView x:Name="ResultTableHost" Grid.Row="3" Table="{Binding Table}"/>

            <!-- 三、逐段明细 -->
            <TextBlock Grid.Row="4" Style="{StaticResource SectionTitle}" Text="{Binding DetailTitle}"/>
            <DataGrid Grid.Row="5" x:Name="SegmentGrid" Style="{StaticResource Grid}"
                      ItemsSource="{Binding SegmentRows}" AlternatingRowBackground="#F7FAFD"
                      HorizontalScrollBarVisibility="Auto">
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OnCriticalPath}" Value="True">
                                <Setter Property="Background" Value="#FFF4E5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="段名" Width="200" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="断面" Width="130" Binding="{Binding SectionText}"/>
                    <DataGridTextColumn Header="流量 m³/h" Width="100" Binding="{Binding FlowM3H, StringFormat={}{0:N0}}"/>
                    <DataGridTextColumn Header="流速 m/s" Width="90" Binding="{Binding VelocityMs, StringFormat={}{0:N2}}"/>
                    <DataGridTextColumn Header="雷诺数" Width="96" Binding="{Binding Reynolds, StringFormat={}{0:N0}}"/>
                    <DataGridTextColumn Header="λ" Width="80" Binding="{Binding FrictionFactor, StringFormat={}{0:0.00000}}"/>
                    <DataGridTextColumn Header="比摩阻 Pa/m" Width="110" Binding="{Binding SpecificFrictionPaPerM, StringFormat={}{0:N2}}"/>
                    <DataGridTextColumn Header="长度 m" Width="80" Binding="{Binding LengthM, StringFormat={}{0:N2}}"/>
                    <DataGridTextColumn Header="沿程 Pa" Width="96" Binding="{Binding FrictionLossPa, StringFormat={}{0:N1}}"/>
                    <DataGridTextColumn Header="Σζ" Width="70" Binding="{Binding LocalZetaSum, StringFormat={}{0:0.###}}"/>
                    <DataGridTextColumn Header="局部 Pa" Width="96" Binding="{Binding LocalLossPa, StringFormat={}{0:N1}}"/>
                    <DataGridTextColumn Header="段合计 Pa" Width="104" Binding="{Binding TotalLossPa, StringFormat={}{0:N1}}"/>
                    <DataGridTextColumn Header="环路" Width="54" Binding="{Binding OnCriticalPath}"/>
                    <DataGridTextColumn Header="数据来源" Width="*" Binding="{Binding Source}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 四、环路阻力项 -->
            <TextBlock Grid.Row="6" Style="{StaticResource SectionTitle}" Margin="4,6,0,4"
                       Text="四、环路阻力项(末端 / 设备 / 出口动压;勾选 = 计入最不利环路)"/>
            <DataGrid Grid.Row="7" x:Name="ItemGrid" Style="{StaticResource Grid}"
                      ItemsSource="{Binding ItemRows}" AlternatingRowBackground="#F7FAFD"
                      HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="类别" Width="90" Binding="{Binding KindText}"/>
                    <DataGridTextColumn Header="名称" Width="280" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="阻力 Pa" Width="110" Binding="{Binding ResistancePa, StringFormat={}{0:N1}}"/>
                    <DataGridTextColumn Header="来源" Width="420" Binding="{Binding Source}"/>
                    <DataGridCheckBoxColumn Header="计入环路" Width="90" Binding="{Binding OnCriticalPath}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 五、并联环路平衡 -->
            <TextBlock Grid.Row="8" Style="{StaticResource SectionTitle}" Margin="4,6,0,4"
                       Text="五、并联环路平衡(超限支路给出平衡阀 Kv / 需增加 ζ;最不利环路行高亮)"/>
            <DataGrid Grid.Row="9" x:Name="BranchGrid" Style="{StaticResource Grid}"
                      ItemsSource="{Binding BranchRows}" AlternatingRowBackground="#F7FAFD"
                      HorizontalScrollBarVisibility="Auto">
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                <Setter Property="Background" Value="#FFF4E5"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding WithinLimit}" Value="False">
                                <Setter Property="Foreground" Value="#C0392B"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="支路(末端)" Width="180" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="段数" Width="60" Binding="{Binding SegmentCount}"/>
                    <DataGridTextColumn Header="管段 Pa" Width="96" Binding="{Binding SegmentLossPa, StringFormat={}{0:N1}}"/>
                    <DataGridTextColumn Header="末端 Pa" Width="96" Binding="{Binding TerminalPa, StringFormat={}{0:N1}}"/>
                    <DataGridTextColumn Header="支路合计 Pa" Width="110" Binding="{Binding TotalLossPa, StringFormat={}{0:N1}}"/>
                    <DataGridTextColumn Header="不平衡 Pa" Width="100" Binding="{Binding ImbalancePa, StringFormat={}{0:N1}}"/>
                    <DataGridTextColumn Header="不平衡 %" Width="90" Binding="{Binding ImbalancePct, StringFormat={}{0:0.#}}"/>
                    <DataGridTextColumn Header="需吸收 Pa" Width="100" Binding="{Binding RequiredAbsorbPa, StringFormat={}{0:N1}}"/>
                    <DataGridTextColumn Header="平衡阀 Kv" Width="94" Binding="{Binding ValveKv, StringFormat={}{0:0.##}}"/>
                    <DataGridTextColumn Header="阀权度" Width="76" Binding="{Binding ValveAuthority, StringFormat={}{0:0.00}}"/>
                    <DataGridTextColumn Header="需增加 ζ" Width="92" Binding="{Binding ZetaToAdd, StringFormat={}{0:0.###}}"/>
                    <DataGridTextColumn Header="结论" Width="*" Binding="{Binding Conclusion}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 六、系统阻力特性曲线 -->
            <TextBlock Grid.Row="10" Style="{StaticResource SectionTitle}" Margin="4,6,0,4"
                       Text="六、系统阻力特性曲线(与厂家设备性能曲线的交点才是工况点)"/>
            <DataGrid Grid.Row="11" x:Name="CurveGrid" Style="{StaticResource Grid}" MaxHeight="150"
                      ItemsSource="{Binding CurveRows}" AlternatingRowBackground="#F7FAFD">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="流量比 %" Width="100" Binding="{Binding FlowRatioPct, StringFormat={}{0:0}}"/>
                    <DataGridTextColumn Header="流量 m³/h" Width="120" Binding="{Binding FlowM3H, StringFormat={}{0:N0}}"/>
                    <DataGridTextColumn Header="系统阻力 Pa" Width="130" Binding="{Binding ResistancePa, StringFormat={}{0:N1}}"/>
                    <DataGridTextColumn Header="需求值 Pa" Width="130" Binding="{Binding RequiredPa, StringFormat={}{0:N1}}"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="12" Margin="4,4,4,0" TextWrapping="Wrap"
                       Foreground="#8A6100" Text="{Binding BalanceNote}"/>

            <Expander Grid.Row="13" Margin="0,8,0,0" Foreground="#23486E" Header="七、选中介质的计算书全文(文本,可导出)">
                <TextBox Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="12" Height="150"
                         Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Padding="8"/>
            </Expander>
        </Grid>
    </DockPanel>
</Window>
