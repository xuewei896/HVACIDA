<Window x:Class="HVACIDA.UI.Views.LargeSystemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大系统负荷计算 - HVACIDA"
        Width="1500" Height="840"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Width" Value="188"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,3,2,3"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="FieldInput" TargetType="{x:Type TextBox}">
            <Setter Property="Width" Value="130"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,3,10,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style x:Key="SectionBox" TargetType="{x:Type GroupBox}">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 顶部提示 -->
        <Border DockPanel.Dock="Top" Background="#FFF4E5" Padding="8,6">
            <TextBlock Text="参数表与《大系统负荷计算公式.docx》一致(括号为单元格代号)。客流统计必填;其余有公式文档默认值。送风温度按站厅统一确定(两区一致);排烟选型系数 1.2。点击【计算】查看与北京站算例同口径的结果。"
                       TextWrapping="Wrap" Foreground="#8A6100"/>
        </Border>

        <!-- 底部操作区 -->
        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="计 算" Width="90" Height="30" Margin="0,0,8,0"
                            Command="{Binding CalculateCommand}" IsDefault="True"/>
                    <Button Content="导出计算书" Width="110" Height="30"
                            Command="{Binding ExportCommand}"/>
                    <Button Content="恢复默认参数" Width="120" Height="30" Margin="8,0,0,0"
                            Command="{Binding ResetCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" Foreground="#2E7D32"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= 输入参数(按公式文档分节) ================= -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="4">
                <StackPanel>

                    <GroupBox Header="一、空气计算参数及标准" Style="{StaticResource SectionBox}">
                        <UniformGrid Columns="2">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="夏季空调室外湿球温度 ℃(C5)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.OutdoorWetBulbC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅空调计算干球温度 ℃(F4)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallDesignTempC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台空调计算干球温度 ℃(F6)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformDesignTempC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅公共区风温差 ℃(C8)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.SupplyTempDiffC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="管道温升 ℃(C10)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.DuctTempRiseC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="露点相对湿度 %(C118)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.DewPointRelativeHumidityPercent, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="壁面产湿量 g/(m²·h)(A91)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.WallMoistureEmission, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="空调季新风量指标 m³/(h·人)(B132)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.FreshAirPerPersonM3H, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </UniformGrid>
                    </GroupBox>

                    <GroupBox Header="二、车站基础资料(几何/出入口)" Style="{StaticResource SectionBox}">
                        <UniformGrid Columns="2">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅公共区面积 m²(D55)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallAreaM2, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台公共区面积 m²(D56)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformAreaM2, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅公共区层高 m(C13)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallHeightM, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅公共区长度 m(C14)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallLengthM, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="出入口A 宽×高 m"/><TextBox Width="90" VerticalAlignment="Center" Margin="2,3,4,3" Text="{Binding Input.EntranceAWidthM, UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="70" VerticalAlignment="Center" Margin="2,3,10,3" Text="{Binding Input.EntranceAHeightM, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="出入口B 宽×高 m"/><TextBox Width="90" VerticalAlignment="Center" Margin="2,3,4,3" Text="{Binding Input.EntranceBWidthM, UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="70" VerticalAlignment="Center" Margin="2,3,10,3" Text="{Binding Input.EntranceBHeightM, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="出入口C 宽×高 m"/><TextBox Width="90" VerticalAlignment="Center" Margin="2,3,4,3" Text="{Binding Input.EntranceCWidthM, UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="70" VerticalAlignment="Center" Margin="2,3,10,3" Text="{Binding Input.EntranceCHeightM, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="出入口D 宽×高 m"/><TextBox Width="90" VerticalAlignment="Center" Margin="2,3,4,3" Text="{Binding Input.EntranceDWidthM, UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="70" VerticalAlignment="Center" Margin="2,3,10,3" Text="{Binding Input.EntranceDHeightM, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="出入口负荷指标 W(B82)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.EntranceLoadIndexW, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </UniformGrid>
                    </GroupBox>

                    <GroupBox Header="三、高峰客流资料统计" Style="{StaticResource SectionBox}">
                        <StackPanel>
                            <TextBlock Text="1、高峰小时客流量(人次/h;上/下客量 A27/B27/C27/D27/E27/F27)" FontWeight="Bold" Margin="4,2"/>
                            <UniformGrid Columns="2">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="上行线 上客量(A27)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.UpLineBoardCount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="上行线 下客量(B27)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.UpLineAlightCount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="下行线 上客量(C27)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.DownLineBoardCount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="下行线 下客量(D27)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.DownLineAlightCount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="换乘 上客量(E27)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.TransferBoardCount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="换乘 下客量(F27)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.TransferAlightCount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </UniformGrid>
                            <TextBlock Text="2、客流停站时间(min;D29~D32 站厅/F29~F32 站台)" FontWeight="Bold" Margin="4,6,4,2"/>
                            <UniformGrid Columns="2">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅 上车停站(D29)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallBoardStayMin, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅 下车停站(D30)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallAlightStayMin, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅 换乘上车停站(D31)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallTransferBoardStayMin, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅 换乘下车停站(D32)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallTransferAlightStayMin, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台 上车停站(F29)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformBoardStayMin, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台 下车停站(F30)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformAlightStayMin, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台 换乘上车停站(F31)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformTransferBoardStayMin, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台 换乘下车停站(F32)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformTransferAlightStayMin, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="集群系数(C37)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.ClusterFactor, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="超高峰小时系数(F37)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.SuperPeakHourFactor, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="四、人员散热、散湿量标准" Style="{StaticResource SectionBox}">
                        <UniformGrid Columns="2">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅 显热 W/人(D45)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallOccupantSensibleW, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅 潜热 W/人(E45)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallOccupantLatentW, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅 散湿量 g/h(F45)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallOccupantMoistureGH, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台 显热 W/人(D46)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformOccupantSensibleW, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台 潜热 W/人(E46)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformOccupantLatentW, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台 散湿量 g/h(F46)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformOccupantMoistureGH, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </UniformGrid>
                    </GroupBox>

                    <GroupBox Header="五、照明 / 广告 / 设备发热量" Style="{StaticResource SectionBox}">
                        <StackPanel>
                            <TextBlock Text="照明(C55/C56)与广告(C58/C59)" FontWeight="Bold" Margin="4,2"/>
                            <UniformGrid Columns="2">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅照明指标 W/m²(C55)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallLightingWm2, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台照明指标 W/m²(C56)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformLightingWm2, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅广告牌发热量 kW(C58)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallAdvertKw, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台广告牌发热量 kW(C59)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformAdvertKw, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </UniformGrid>
                            <TextBlock Text="扶梯 / 直梯 / AFC(B62/B63,D62/D63,E62/E63)" FontWeight="Bold" Margin="4,6,4,2"/>
                            <UniformGrid Columns="2">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="公共区扶梯指标 kW/台(B62)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.EscalatorKwPerUnit, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="公共区扶梯数量 台(B63)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.EscalatorCount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="公共区直梯指标 kW/台(D62)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.ElevatorKwPerUnit, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="公共区直梯数量 台(D63)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.ElevatorCount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="AFC 设备指标 kW/台(E62)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.AfcKwPerUnit, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="AFC 设备数量 台(E63)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.AfcCount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="六、屏蔽门传热 / 漏风 / 发热" Style="{StaticResource SectionBox}">
                        <StackPanel>
                            <TextBlock Text="1、屏蔽门传热(A71×B71×C71×D71×E71/1000 → 站台 E103)" FontWeight="Bold" Margin="4,2"/>
                            <UniformGrid Columns="2">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="传热系数 W/(m²·℃)(A71)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PsdHeatTransferCoeffWm2C, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="屏蔽门高 m(B71)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PsdHeightM, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="屏蔽门长 m(C71)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PsdLengthM, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="内外温差 ℃(D71)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PsdTempDiffC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="传热安全系数(E71)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PsdHeatSafetyFactor, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </UniformGrid>
                            <TextBlock Text="2、漏风 / 发热 / 补充(D103/A75/D105/B75/C76/D106/E106)" FontWeight="Bold" Margin="4,6,4,2"/>
                            <UniformGrid Columns="2">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅屏蔽门传热量 kW(D103)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallPsdTransferKw, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅屏蔽门漏风 kW(A75)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallPsdLeakKw, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅屏蔽门发热 kW(D105)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallPsdHeatKw, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台屏蔽门漏风 kW(B75)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformPsdLeakKw, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="屏蔽门系统发热 kW(C76)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformPsdSystemHeatKw, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅其他补充发热 kW(D106)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallExtraHeatKw, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台其他补充发热 kW(E106)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformExtraHeatKw, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="七、其他湿负荷(E109/E110/D110)" Style="{StaticResource SectionBox}">
                        <UniformGrid Columns="2">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅其他湿负荷(D110)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallOtherMoisture, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台其他湿负荷(E110)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformOtherMoisture, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台结构散湿(覆盖,0=不计)(E109)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformStructureMoistureOverride, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </UniformGrid>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="#DDDDDD" ResizeBehavior="PreviousAndNext"/>

            <!-- ================= 结果区 ================= -->
            <Border Grid.Column="2" Margin="4" BorderBrush="#DDDDDD" BorderThickness="1" Background="#FAFAFA">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="计算结果(单元格见左侧标注)" FontWeight="Bold" Padding="8,6" Background="#EFEFEF"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding ResultText}" Padding="10" FontFamily="Consolas" FontSize="11"
                                   TextWrapping="Wrap" VerticalAlignment="Top"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
