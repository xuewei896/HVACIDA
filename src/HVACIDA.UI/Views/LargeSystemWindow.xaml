<Window x:Class="HVACIDA.UI.Views.LargeSystemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HVACIDA.UI.Views"
        Title="大系统负荷计算 - HVACIDA"
        Width="1500" Height="840"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Width" Value="188"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,3,2,3"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="FieldInput" TargetType="{x:Type TextBox}">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,3,10,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <!-- 用户必须输入的数据(无公式默认值):琥珀色标签 + 浅琥珀底,与"公式默认参数"区分 -->
        <Style x:Key="RequiredLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Foreground" Value="#B45309"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="RequiredInput" TargetType="{x:Type TextBox}" BasedOn="{StaticResource FieldInput}">
            <Setter Property="Background" Value="#FFF8E1"/>
            <Setter Property="BorderBrush" Value="#E8C06A"/>
        </Style>
        <Style x:Key="SectionBox" TargetType="{x:Type GroupBox}">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <!-- 气象联动字段(C5/F4/F6):联动期间只读灰底,取消勾选后转为可编辑,见 UI设计规范 §2.5 -->
        <Style x:Key="WeatherField" TargetType="{x:Type TextBox}" BasedOn="{StaticResource FieldInput}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding WeatherLinked}" Value="True">
                    <Setter Property="IsReadOnly" Value="True"/>
                    <Setter Property="Background" Value="#F0F0F0"/>
                    <Setter Property="Foreground" Value="#666666"/>
                    <Setter Property="ToolTip" Value="来自 Ribbon「项目信息 → 气象参数」(C5 湿球、F4 站厅干球、F6 站台干球)。取消勾选上方【随项目信息自动联动】可手工覆盖。"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 底部操作区 -->
        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="计 算" Width="90" Height="30" Margin="0,0,8,0"
                            Command="{Binding CalculateCommand}" IsDefault="True"
                            ToolTip="计算并把本次输入保存到 large-system.xml(「大系统 → 计算结果」窗读的就是这份参数,故那边打开即有结果;界面右侧结果区本窗打开时也已自动算过)"/>
                    <Button Content="恢复默认参数" Width="120" Height="30"
                            Command="{Binding ResetCommand}"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="取 消" Width="96" Height="30" IsCancel="True"/>
                <Button x:Name="ConfirmButton" DockPanel.Dock="Right" Content="确 定" Width="100" Height="30" Margin="0,0,8,0"
                        Click="OnConfirmClick"
                        ToolTip="保存本次参数到 large-system.xml 并关闭本窗;保存失败时不关窗,状态栏给出原因"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,12,0"
                           TextTrimming="CharacterEllipsis" Foreground="#2E7D32"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= 输入参数(按公式文档分节) ================= -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="4">
                <StackPanel>

                    <GroupBox Header="一、空气计算参数及标准" Style="{StaticResource SectionBox}"
                              ToolTip="参数表与《大系统负荷计算公式.docx》一致;送风温度按站厅统一确定(两区一致)">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="4,0,0,4">
                                <CheckBox Content="随「项目信息 → 气象参数」自动联动" VerticalAlignment="Center"
                                          IsChecked="{Binding AutoSyncWeather}"
                                          ToolTip="联动三格:C5 湿球、F4 站厅干球、F6 站台干球。勾选(默认)时这三格由项目信息气象参数提供且只读;取消勾选转为手工输入"/>
                                <Button Content="重新同步" Height="24" Padding="10,0" Margin="12,0,0,0"
                                        Command="{Binding SyncWeatherCommand}"
                                        ToolTip="重新读取「项目信息 → 气象参数」并回填 C5/F4/F6"/>
                            </StackPanel>
                            <TextBlock Text="{Binding WeatherNote}" Margin="4,0,4,6" TextWrapping="Wrap" Foreground="#2E7D32"/>
                            <UniformGrid Columns="2">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="夏季空调室外湿球温度 ℃" ToolTip="对应公式文档单元格 C5"/><TextBox x:Name="WetBulbBox" Style="{StaticResource WeatherField}" Text="{Binding Input.OutdoorWetBulbC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅空调计算干球温度 ℃" ToolTip="对应公式文档单元格 F4"/><TextBox Style="{StaticResource WeatherField}" Text="{Binding Input.HallDesignTempC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台空调计算干球温度 ℃" ToolTip="对应公式文档单元格 F6"/><TextBox Style="{StaticResource WeatherField}" Text="{Binding Input.PlatformDesignTempC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅公共区风温差 ℃" ToolTip="对应公式文档单元格 C8"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.SupplyTempDiffC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="管道温升 ℃" ToolTip="对应公式文档单元格 C10"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.DuctTempRiseC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="露点相对湿度 %" ToolTip="对应公式文档单元格 C118"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.DewPointRelativeHumidityPercent, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="壁面产湿量 g/(m²·h)" ToolTip="对应公式文档单元格 A91"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.WallMoistureEmission, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="空调季新风量指标 m³/(h·人)" ToolTip="对应公式文档单元格 B132"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.FreshAirPerPersonM3H, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="二、车站基础资料" Style="{StaticResource SectionBox}"
                              ToolTip="几何 / 出入口;公共区几何可由「公共区参数」窗从模型空间取值">
                        <UniformGrid Columns="2">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅公共区面积 m²" ToolTip="对应公式文档单元格 D55"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallAreaM2, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台公共区面积 m²" ToolTip="对应公式文档单元格 D56"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformAreaM2, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅公共区层高 m" ToolTip="对应公式文档单元格 C13"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallHeightM, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅公共区长度 m" ToolTip="对应公式文档单元格 C14"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallLengthM, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="出入口A 宽×高 m"/><TextBox Width="90" VerticalAlignment="Center" Margin="2,3,4,3" Text="{Binding Input.EntranceAWidthM, UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="70" VerticalAlignment="Center" Margin="2,3,10,3" Text="{Binding Input.EntranceAHeightM, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="出入口B 宽×高 m"/><TextBox Width="90" VerticalAlignment="Center" Margin="2,3,4,3" Text="{Binding Input.EntranceBWidthM, UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="70" VerticalAlignment="Center" Margin="2,3,10,3" Text="{Binding Input.EntranceBHeightM, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="出入口C 宽×高 m"/><TextBox Width="90" VerticalAlignment="Center" Margin="2,3,4,3" Text="{Binding Input.EntranceCWidthM, UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="70" VerticalAlignment="Center" Margin="2,3,10,3" Text="{Binding Input.EntranceCHeightM, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="出入口D 宽×高 m"/><TextBox Width="90" VerticalAlignment="Center" Margin="2,3,4,3" Text="{Binding Input.EntranceDWidthM, UpdateSourceTrigger=PropertyChanged}"/><TextBox Width="70" VerticalAlignment="Center" Margin="2,3,10,3" Text="{Binding Input.EntranceDHeightM, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="出入口负荷指标 W" ToolTip="对应公式文档单元格 B82"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.EntranceLoadIndexW, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </UniformGrid>
                    </GroupBox>

                    <GroupBox Header="三、高峰客流资料统计" Style="{StaticResource SectionBox}"
                              ToolTip="本组为必填项:琥珀色字段没有公式默认值,必须由用户按客流预测填写;其余黑色字段为《大系统负荷计算公式.docx》默认值,可不动">
                        <StackPanel>
                            <TextBlock Text="1、高峰小时客流量" FontWeight="Bold" Margin="4,2"
                               ToolTip="单位:人次/h;按上行/下行线的上客量与下客量、换乘上客量与下客量分别填写(共 6 项)"/>
                            <UniformGrid Columns="2">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource RequiredLabel}" Text="上行线 上客量" ToolTip="必填;对应公式文档单元格 A27"/><TextBox Style="{StaticResource RequiredInput}" Text="{Binding Input.UpLineBoardCount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource RequiredLabel}" Text="上行线 下客量" ToolTip="必填;对应公式文档单元格 B27"/><TextBox Style="{StaticResource RequiredInput}" Text="{Binding Input.UpLineAlightCount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource RequiredLabel}" Text="下行线 上客量" ToolTip="必填;对应公式文档单元格 C27"/><TextBox Style="{StaticResource RequiredInput}" Text="{Binding Input.DownLineBoardCount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource RequiredLabel}" Text="下行线 下客量" ToolTip="必填;对应公式文档单元格 D27"/><TextBox Style="{StaticResource RequiredInput}" Text="{Binding Input.DownLineAlightCount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource RequiredLabel}" Text="换乘 上客量" ToolTip="必填;对应公式文档单元格 E27"/><TextBox Style="{StaticResource RequiredInput}" Text="{Binding Input.TransferBoardCount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource RequiredLabel}" Text="换乘 下客量" ToolTip="必填;对应公式文档单元格 F27"/><TextBox Style="{StaticResource RequiredInput}" Text="{Binding Input.TransferAlightCount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </UniformGrid>
                            <TextBlock Text="2、客流停站时间" FontWeight="Bold" Margin="4,6,4,2"
                               ToolTip="单位 min;站厅与站台各 4 项:上车停站、下车停站、换乘上车停站、换乘下车停站"/>
                            <UniformGrid Columns="2">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅 上车停站" ToolTip="对应公式文档单元格 D29"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallBoardStayMin, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅 下车停站" ToolTip="对应公式文档单元格 D30"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallAlightStayMin, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅 换乘上车停站" ToolTip="对应公式文档单元格 D31"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallTransferBoardStayMin, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅 换乘下车停站" ToolTip="对应公式文档单元格 D32"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallTransferAlightStayMin, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台 上车停站" ToolTip="对应公式文档单元格 F29"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformBoardStayMin, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台 下车停站" ToolTip="对应公式文档单元格 F30"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformAlightStayMin, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台 换乘上车停站" ToolTip="对应公式文档单元格 F31"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformTransferBoardStayMin, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台 换乘下车停站" ToolTip="对应公式文档单元格 F32"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformTransferAlightStayMin, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="集群系数" ToolTip="对应公式文档单元格 C37"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.ClusterFactor, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="超高峰小时系数" ToolTip="对应公式文档单元格 F37"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.SuperPeakHourFactor, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="四、人员散热、散湿量标准" Style="{StaticResource SectionBox}">
                        <UniformGrid Columns="2">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅 显热 W/人" ToolTip="对应公式文档单元格 D45"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallOccupantSensibleW, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅 潜热 W/人" ToolTip="对应公式文档单元格 E45"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallOccupantLatentW, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅 散湿量 g/h" ToolTip="对应公式文档单元格 F45"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallOccupantMoistureGH, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台 显热 W/人" ToolTip="对应公式文档单元格 D46"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformOccupantSensibleW, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台 潜热 W/人" ToolTip="对应公式文档单元格 E46"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformOccupantLatentW, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台 散湿量 g/h" ToolTip="对应公式文档单元格 F46"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformOccupantMoistureGH, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </UniformGrid>
                    </GroupBox>

                    <GroupBox Header="五、照明 / 广告 / 设备发热量" Style="{StaticResource SectionBox}">
                        <StackPanel>
                            <TextBlock Text="照明与广告" FontWeight="Bold" Margin="4,2" ToolTip="对应公式文档单元格 C55/C56、C58/C59"/>
                            <UniformGrid Columns="2">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅照明指标 W/m²" ToolTip="对应公式文档单元格 C55"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallLightingWm2, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台照明指标 W/m²" ToolTip="对应公式文档单元格 C56"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformLightingWm2, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅广告牌发热量 kW" ToolTip="对应公式文档单元格 C58"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallAdvertKw, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台广告牌发热量 kW" ToolTip="对应公式文档单元格 C59"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformAdvertKw, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </UniformGrid>
                            <TextBlock Text="扶梯 / 直梯 / AFC" FontWeight="Bold" Margin="4,6,4,2" ToolTip="对应公式文档单元格 B62/B63,D62/D63,E62/E63"/>
                            <UniformGrid Columns="2">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="公共区扶梯指标 kW/台" ToolTip="对应公式文档单元格 B62"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.EscalatorKwPerUnit, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="公共区扶梯数量 台" ToolTip="对应公式文档单元格 B63"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.EscalatorCount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="公共区直梯指标 kW/台" ToolTip="对应公式文档单元格 D62"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.ElevatorKwPerUnit, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="公共区直梯数量 台" ToolTip="对应公式文档单元格 D63"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.ElevatorCount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="AFC 设备指标 kW/台" ToolTip="对应公式文档单元格 E62"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.AfcKwPerUnit, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="AFC 设备数量 台" ToolTip="对应公式文档单元格 E63"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.AfcCount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="六、屏蔽门传热 / 漏风 / 发热" Style="{StaticResource SectionBox}">
                        <StackPanel>
                            <TextBlock Text="1、屏蔽门传热" FontWeight="Bold" Margin="4,2"
                               ToolTip="传热系数 × 屏蔽门高 × 屏蔽门长 × 内外温差 × 传热安全系数 ÷ 1000 = 站台屏蔽门传热量"/>
                            <UniformGrid Columns="2">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="传热系数 W/(m²·℃)" ToolTip="对应公式文档单元格 A71"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PsdHeatTransferCoeffWm2C, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="屏蔽门高 m" ToolTip="对应公式文档单元格 B71"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PsdHeightM, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="屏蔽门长 m" ToolTip="对应公式文档单元格 C71"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PsdLengthM, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="内外温差 ℃" ToolTip="对应公式文档单元格 D71"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PsdTempDiffC, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="传热安全系数" ToolTip="对应公式文档单元格 E71"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PsdHeatSafetyFactor, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </UniformGrid>
                            <TextBlock Text="2、漏风 / 发热 / 补充" FontWeight="Bold" Margin="4,6,4,2" ToolTip="对应公式文档单元格 D103/A75/D105/B75/C76/D106/E106"/>
                            <UniformGrid Columns="2">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅屏蔽门传热量 kW" ToolTip="对应公式文档单元格 D103"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallPsdTransferKw, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅屏蔽门漏风 kW" ToolTip="对应公式文档单元格 A75"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallPsdLeakKw, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅屏蔽门发热 kW" ToolTip="对应公式文档单元格 D105"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallPsdHeatKw, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台屏蔽门漏风 kW" ToolTip="对应公式文档单元格 B75"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformPsdLeakKw, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="屏蔽门系统发热 kW" ToolTip="对应公式文档单元格 C76"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformPsdSystemHeatKw, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅其他补充发热 kW" ToolTip="对应公式文档单元格 D106"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallExtraHeatKw, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台其他补充发热 kW" ToolTip="对应公式文档单元格 E106"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformExtraHeatKw, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="七、其他湿负荷" Style="{StaticResource SectionBox}">
                        <UniformGrid Columns="2">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站厅其他湿负荷" ToolTip="对应公式文档单元格 D110"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.HallOtherMoisture, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台其他湿负荷" ToolTip="对应公式文档单元格 E110"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformOtherMoisture, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource FieldLabel}" Text="站台结构散湿" ToolTip="覆盖值;0 = 不计(对应公式文档单元格 E109)"/><TextBox Style="{StaticResource FieldInput}" Text="{Binding Input.PlatformStructureMoistureOverride, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </UniformGrid>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="#DDDDDD" ResizeBehavior="PreviousAndNext"/>

            <!-- ================= 结果区:按分区分组的结果表格 ================= -->
            <Border Grid.Column="2" Margin="4" BorderBrush="#DDDDDD" BorderThickness="1" Background="#FAFAFA">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="计算结果" FontWeight="Bold" Padding="8,6" Background="#EFEFEF"
                               ToolTip="按分区分组;行尾灰字为公式文档单元格代号"/>
                    <views:ResultTableView x:Name="ResultTableHost" Margin="6,6,6,0" Table="{Binding Table}"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
