<Window x:Class="HVACIDA.UI.Views.MaterialTakeoffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HVACIDA.UI.Views"
        Title="{Binding WindowTitle}"
        Width="1200" Height="820" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Grid" TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#DDDDDD"/>
            <Setter Property="VerticalGridLinesBrush" Value="#DDDDDD"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowHeight" Value="24"/>
            <Setter Property="ColumnHeaderHeight" Value="28"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4,6,0,4"/>
            <Setter Property="Foreground" Value="#23486E"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#E8F0FE" Padding="8,6">
            <StackPanel>
                <TextBlock Text="{Binding SummaryTitle, Mode=OneWay}" TextWrapping="Wrap" FontWeight="Bold" Foreground="#23486E"
                           ToolTip="按「类别 + 族 + 类型 + 单位」归并;单位进归并键,长度与件数不互相求和"/>
                <TextBlock Text="{Binding SourceNote}" TextWrapping="Wrap" Foreground="#5A5A5A" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding PendingNote}" TextWrapping="Wrap" Foreground="#C0392B" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="ReloadButton" Content="重新读取模型" Width="120" Height="30"
                            Command="{Binding ReloadCommand}"
                            ToolTip="点击后本窗关闭,重新读取当前模型的构件(风管/水管/管件/附件/末端/设备/保温),随后自动回到本窗"/>
                    <Button Content="导出 Excel" Width="104" Height="30" Margin="8,0,0,0" Command="{Binding ExportExcelCommand}"
                            ToolTip="导出 .xlsx:类别小计 / 逐类型明细 / 口径与待补"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="关 闭" Width="90" Height="30" IsCancel="True"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" Foreground="#2E7D32"/>
            </DockPanel>
        </Border>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="0.9*" MinHeight="110"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.6*" MinHeight="150"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" Margin="4,0,0,4"
                       Text="一、按类别小计"
                       ToolTip="与计算书 / Excel 同源;单位不一致的类别只给件数"/>
            <views:ResultTableView x:Name="ResultTableHost" Grid.Row="1" Table="{Binding Table}"/>

            <TextBlock Grid.Row="2" Style="{StaticResource SectionTitle}"
                       Text="二、逐类型明细"
                       ToolTip="类别 / 族 / 类型 / 数量 / 单位 / 件数"/>
            <DataGrid Grid.Row="3" x:Name="TakeoffGrid" Style="{StaticResource Grid}"
                      ItemsSource="{Binding Rows}" AlternatingRowBackground="#F7FAFD"
                      HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="类别" Width="140" Binding="{Binding CategoryName}"/>
                    <DataGridTextColumn Header="族" Width="220" Binding="{Binding FamilyName}"/>
                    <DataGridTextColumn Header="类型" Width="240" Binding="{Binding TypeName}"/>
                    <DataGridTextColumn Header="数量" Width="110" Binding="{Binding TotalQuantity, StringFormat={}{0:N2}}"/>
                    <DataGridTextColumn Header="单位" Width="70" Binding="{Binding Unit}"/>
                    <DataGridTextColumn Header="件数" Width="80" Binding="{Binding TotalCount, StringFormat={}{0:N0}}"/>
                    <DataGridTextColumn Header="备注" Width="*" Binding="{Binding Note}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
