<Window x:Class="HVACIDA.UI.Views.SheetCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HVACIDA.UI.Views"
        Title="{Binding WindowTitle}"
        Width="1240" Height="860" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Grid" TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#DDDDDD"/>
            <Setter Property="VerticalGridLinesBrush" Value="#DDDDDD"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowHeight" Value="24"/>
            <Setter Property="ColumnHeaderHeight" Value="28"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4,6,0,4"/>
            <Setter Property="Foreground" Value="#23486E"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#E8F0FE" Padding="8,6">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="#23486E">
                    <Run Text="出图 — 图框(图纸清单与批量出图,需求 2.6):"/><Run Text="{Binding SummaryTitle, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text="   ·   DWG/DXF 走 Revit 导出接口;PDF 走系统打印机(依赖本机 PDF 打印机驱动)"/>
                </TextBlock>
                <TextBlock Text="{Binding SourceNote}" TextWrapping="Wrap" Foreground="#5A5A5A" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding PendingNote}" TextWrapping="Wrap" Foreground="#C0392B" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="重新读取图纸" Width="120" Height="30" Command="{Binding ReloadCommand}"
                            ToolTip="本窗关闭后重新读取模型里的图纸清单,随后自动回到本窗"/>
                    <Button Content="导出 DWG" Width="100" Height="30" Margin="8,0,0,0" Command="{Binding ExportDwgCommand}"
                            ToolTip="把清单里的图纸逐张导出为 DWG(文件名取「图纸编号_图纸名称」;空图框跳过并记录)"/>
                    <Button Content="导出 DXF" Width="100" Height="30" Margin="8,0,0,0" Command="{Binding ExportDxfCommand}"/>
                    <Button Content="导出 PDF" Width="100" Height="30" Margin="8,0,0,0" Command="{Binding ExportPdfCommand}"
                            ToolTip="用系统打印机把图纸逐张打印为 PDF;本机没有 PDF 打印机时会逐张写明失败原因,不谎报成功"/>
                    <Button Content="批量标注空间" Width="126" Height="30" Margin="8,0,0,0" Command="{Binding TagCommand}"
                            ToolTip="在楼层/天花平面视图里给空间批量添加「名称 + 编号」标注;已有空间标注的视图跳过,新增/跳过/失败逐视图计数"/>
                    <Button Content="导出清单 Excel" Width="126" Height="30" Margin="8,0,0,0" Command="{Binding ExportExcelCommand}"
                            ToolTip="导出 .xlsx:概况与图框 / 逐张图纸 / 批量出图记录 / 口径与待补"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="关 闭" Width="90" Height="30" IsCancel="True"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" Foreground="#2E7D32"/>
            </DockPanel>
        </Border>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="0.8*" MinHeight="100"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.2*" MinHeight="130"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="0.7*" MinHeight="90"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,6">
                <TextBlock Text="输出目录" VerticalAlignment="Center"/>
                <TextBox Width="560" Margin="8,0,0,0" VerticalAlignment="Center"
                         Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="批量出图的输出目录(不存在会自动创建);默认 %AppData%\HVACIDA\Export"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Style="{StaticResource SectionTitle}" Margin="4,0,0,4"
                       Text="一、图纸概况与图框统计(与计算书 / Excel 同源)"/>
            <views:ResultTableView x:Name="ResultTableHost" Grid.Row="2" Table="{Binding Table}"/>

            <DataGrid Grid.Row="3" x:Name="SheetGrid" Style="{StaticResource Grid}" Margin="0,6,0,0"
                      ItemsSource="{Binding Sheets}" AlternatingRowBackground="#F7FAFD"
                      HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="图纸编号" Width="120" Binding="{Binding SheetNumber}"/>
                    <DataGridTextColumn Header="图纸名称" Width="240" Binding="{Binding SheetName}"/>
                    <DataGridTextColumn Header="图框族" Width="180" Binding="{Binding TitleBlockFamily}"/>
                    <DataGridTextColumn Header="图框类型" Width="160" Binding="{Binding TitleBlockType}"/>
                    <DataGridTextColumn Header="图幅" Width="140" Binding="{Binding SizeText}"/>
                    <DataGridTextColumn Header="视图数" Width="80" Binding="{Binding ViewCount}"/>
                    <DataGridTextColumn Header="空图框" Width="80" Binding="{Binding IsEmpty}"/>
                    <DataGridTextColumn Header="备注" Width="*" Binding="{Binding Note}"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="4" Style="{StaticResource SectionTitle}"
                       Text="二、逐张图纸(点【导出 DWG/DXF/PDF】即按清单逐张出图)"/>
            <DataGrid Grid.Row="5" x:Name="ViewGrid" Style="{StaticResource Grid}"
                      ItemsSource="{Binding Sheets}" AlternatingRowBackground="#F7FAFD"
                      HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="图纸编号" Width="120" Binding="{Binding SheetNumber}"/>
                    <DataGridTextColumn Header="图框上的视图" Width="*" Binding="{Binding ViewCount}"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="6" Style="{StaticResource SectionTitle}"
                       Text="三、批量出图记录(哪张图、什么格式、成功或失败原因)"/>
            <DataGrid Grid.Row="7" x:Name="ExportGrid" Style="{StaticResource Grid}"
                      ItemsSource="{Binding ExportRows}" AlternatingRowBackground="#F7FAFD"
                      HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="图纸编号" Width="120" Binding="{Binding SheetNumber}"/>
                    <DataGridTextColumn Header="图纸名称" Width="220" Binding="{Binding SheetName}"/>
                    <DataGridTextColumn Header="格式" Width="70" Binding="{Binding Format}"/>
                    <DataGridTextColumn Header="成功" Width="70" Binding="{Binding Succeeded}"/>
                    <DataGridTextColumn Header="输出路径" Width="300" Binding="{Binding OutputPath}"/>
                    <DataGridTextColumn Header="说明" Width="*" Binding="{Binding Message}"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="8" Style="{StaticResource SectionTitle}"
                       Text="四、自动标注结果(平面视图里的空间名称 + 编号;逐视图计数)"/>
            <StackPanel Grid.Row="9">
                <TextBlock Text="{Binding TagNote}" TextWrapping="Wrap" Foreground="#C0392B" Margin="0,0,0,4"/>
                <DataGrid x:Name="TagGrid" Style="{StaticResource Grid}" MaxHeight="140"
                          ItemsSource="{Binding TagRows}" AlternatingRowBackground="#F7FAFD"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="视图" Width="220" Binding="{Binding ViewName}"/>
                        <DataGridTextColumn Header="新增标注" Width="100" Binding="{Binding Added}"/>
                        <DataGridTextColumn Header="跳过" Width="80" Binding="{Binding Skipped}"/>
                        <DataGridTextColumn Header="失败" Width="80" Binding="{Binding Failed}"/>
                        <DataGridTextColumn Header="说明" Width="*" Binding="{Binding Message}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
