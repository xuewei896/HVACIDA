<Window x:Class="HVACIDA.UI.Views.AiChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 对话 - HVACIDA"
        Width="560" Height="800" MinWidth="460" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True" Background="White">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel>
        <!-- 标题与总开关 -->
        <Border DockPanel.Dock="Top" Background="#E8F0FE" Padding="10,8"
                ToolTip="与「AI问答 → AI助手」同一套引擎:先本地检索依据 → 连同问题发给大模型 → 需要工程数据时由模型调用进程内命令 → 回答以草稿呈现">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" FontWeight="Bold" Foreground="#23486E" Text="AI 对话(可调用命令取工程数据)"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <CheckBox Content="启用 AI 对话" VerticalAlignment="Center" IsChecked="{Binding Enabled, Mode=TwoWay}"
                              ToolTip="不勾选(或不保存)时不会向大模型发任何请求"/>
                    <CheckBox Content="操作 Revit" VerticalAlignment="Center" Margin="14,0,0,0"
                              IsChecked="{Binding OperateRevit, Mode=TwoWay}"
                              ToolTip="允许模型调用命令。默认关闭:关闭时模型看不到命令、命令也不会执行;开启后命令返回的工程数据会随对话发给模型服务方"/>
                    <TextBlock Text="{Binding OperateRevitText}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#8A6100"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <CheckBox Content="允许模型修改模型" VerticalAlignment="Center"
                              IsChecked="{Binding AllowModify, Mode=TwoWay}"
                              ToolTip="危险开关,第二级,默认关闭:关闭时修改类命令不下发给模型、硬调也被拒绝;开启后每次修改都会弹 Revit 原生对话框(默认按钮是「否」),单次最多改 200 个构件,数值型(带单位)参数一律不写"/>
                    <TextBlock Text="{Binding AllowModifyText}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#C0392B"/>
                </StackPanel>
                <TextBlock Text="{Binding ToolCountText}" TextWrapping="Wrap" Foreground="#5A5A5A" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#2E7D32" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding ScopeText}" TextWrapping="Wrap" Foreground="#8A8A8A" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- 输入区 -->
        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="8,6">
            <StackPanel>
                <TextBox x:Name="QuestionBox" Height="56" TextWrapping="Wrap" AcceptsReturn="False"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="例如:统计一下当前模型的构件数量 / 本项目有哪些空间 / 排烟量怎么确定(会先查知识库)"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="发送" Width="80" Height="28" IsDefault="True"
                            Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}"/>
                    <Button Content="清空对话" Width="88" Height="28" Margin="8,0,0,0" Command="{Binding ClearCommand}"/>
                    <Button Content="清空工具调用" Width="110" Height="28" Margin="8,0,0,0" Command="{Binding ClearLogCommand}"/>
                    <TextBlock Text="错误:" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#C0392B"/>
                    <TextBlock Text="{Binding LastError}" VerticalAlignment="Center" Foreground="#C0392B" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 设置区(可收起) -->
        <Expander DockPanel.Dock="Top" Header="服务与密钥设置" Margin="8,6,0,0">
            <StackPanel Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="服务" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ProviderBox" Width="220" Height="24" Margin="8,0,0,0" VerticalAlignment="Center"
                              ItemsSource="{Binding Providers}" DisplayMemberPath="DisplayText"
                              SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"/>
                    <Button Content="申请 API key" Width="110" Height="24" Margin="8,0,0,0" Command="{Binding OpenKeyPageCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="API key" VerticalAlignment="Center"/>
                    <TextBox x:Name="KeyBox" Width="320" Height="24" Margin="8,0,0,0"
                             Text="{Binding ApiKeyText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按工作区用 Windows DPAPI 加密保存在本机(ai-key.bin),界面不回显已存值以外的内容"/>
                    <Button Content="保存设置" Width="90" Height="24" Margin="8,0,0,0" Command="{Binding SaveCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="模型" VerticalAlignment="Center"/>
                    <TextBox x:Name="ModelBox" Width="180" Height="24" Margin="8,0,0,0"
                             Text="{Binding ModelText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="以服务方官方文档为准;填错会照实报 422/400"/>
                    <TextBlock Text="接口地址" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox x:Name="EndpointBox" Width="320" Height="24" Margin="8,0,0,0"
                             Text="{Binding EndpointText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="OpenAI 兼容 base 地址(不含 /chat/completions)"/>
                </StackPanel>
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#23486E" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="#8A6100" Margin="0,2,0,0"/>
            </StackPanel>
        </Expander>

        <!-- 对话区:聊天记录 + **工具调用逐条打勾**(2027 Autodesk Assistant 那种呈现) -->
        <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto" Background="#FBFDFF"
                      BorderBrush="#DDDDDD" BorderThickness="1" Padding="8">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock TextWrapping="Wrap" FontWeight="Bold" Foreground="#23486E"
                                           Text="我:" Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock TextWrapping="Wrap" FontWeight="Bold" Foreground="#33691E"
                                           Text="AI(草稿):" Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVis}}"
                                           ToolTip="生成文本,不是结论;请对着工具调用与该命令取回的数据核对"/>
                                <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         Background="Transparent" BorderThickness="0" FontFamily="Consolas"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 工具调用行:✓ 完成 / ✗ 失败 + 命令名 + 耗时(逐条列出,与对话同区) -->
                <StackPanel Visibility="{Binding HasToolLog, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="工具调用" FontWeight="Bold" Foreground="#23486E" Margin="0,4,0,4"
                               ToolTip="模型每一次调用命令都列在这里:✓ 完成 / ✗ 失败 + 命令名 + 耗时;命令都在本进程内执行"/>
                    <ItemsControl ItemsSource="{Binding ToolLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                    <TextBlock FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" Text="✓" Foreground="#2E7D32">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Text" Value="✓"/>
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="失败">
                                                        <Setter Property="Text" Value="✗"/>
                                                        <Setter Property="Foreground" Value="#C0392B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Name}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding State}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#5A5A5A"/>
                                    <TextBlock Text="{Binding ElapsedText}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#8A8A8A"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
