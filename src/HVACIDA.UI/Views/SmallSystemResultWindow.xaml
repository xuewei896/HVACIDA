<Window x:Class="HVACIDA.UI.Views.SmallSystemResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HVACIDA.UI.Views"
        Title="小系统 — 计算结果 - HVACIDA"
        Width="940" Height="660" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#E8F0FE" Padding="8,6">
            <TextBlock TextWrapping="Wrap"
                       Text="小系统计算结果(需求 2.2.3.2):负荷 / 湿负荷 / 通风量与新风量 / 设备选型,按分区分组以表格呈现。当前仅「全空气一次回风系统」完成计算链路,其余五类实现后自动纳入;骨架算法结论待按《小系统空调负荷、送排风、排烟计算公式.docx》逐格核对。"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="8,6">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="计 算" Width="100" Height="30"
                        Command="{Binding CalculateCommand}" IsDefault="True"/>
                <Button DockPanel.Dock="Left" Content="导出计算书" Width="110" Height="30" Margin="8,0,0,0"
                        Command="{Binding ExportCommand}"/>
                <Button DockPanel.Dock="Right" Content="关 闭" Width="96" Height="30" IsCancel="True"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" Foreground="#2E7D32"/>
            </DockPanel>
        </Border>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <views:ResultTableView x:Name="ResultTableHost" Grid.Row="0" Table="{Binding Table}"/>
            <Expander Grid.Row="1" Margin="0,6,0,0" Header="计算书全文(文本,可导出)" Foreground="#23486E">
                <TextBox Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="12" Height="140"
                         Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Padding="8"/>
            </Expander>
        </Grid>
    </DockPanel>
</Window>
