<UserControl x:Class="HVACIDA.UI.Views.AiChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI" FontSize="12"
             UseLayoutRounding="True" Background="White">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="Grid" TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#DDDDDD"/>
            <Setter Property="VerticalGridLinesBrush" Value="#DDDDDD"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowHeight" Value="22"/>
            <Setter Property="ColumnHeaderHeight" Value="26"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- 标题与总开关 -->
        <Border DockPanel.Dock="Top" Background="#E8F0FE" Padding="8,6">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" FontWeight="Bold" Foreground="#23486E"
                           Text="AI 助手(进程内 function calling:不起 MCP、不配端口)"/>
                <TextBlock TextWrapping="Wrap" Foreground="#5A5A5A" Margin="0,2,0,0"
                           Text="先本地检索依据 → 连同问题发给大模型 → 需要工程数据时由模型调用下面的命令 → 回答以草稿呈现,请对着数据核对。"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <CheckBox Content="启用 AI 助手" VerticalAlignment="Center" IsChecked="{Binding Enabled, Mode=TwoWay}"
                              ToolTip="不勾选(或不保存)时不会向大模型发任何请求"/>
                    <CheckBox Content="操作 Revit(允许模型调用命令)" VerticalAlignment="Center" Margin="14,0,0,0"
                              IsChecked="{Binding OperateRevit, Mode=TwoWay}"
                              ToolTip="默认关闭:关闭时模型看不到命令、命令也不会执行;开启后命令返回的工程数据会随对话发给模型服务方,项目不允许出网时请保持关闭"/>
                    <TextBlock Text="{Binding OperateRevitText}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#8A6100"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <CheckBox Content="允许模型修改模型(危险:每条都要你确认)" VerticalAlignment="Center"
                              IsChecked="{Binding AllowModify, Mode=TwoWay}"
                              ToolTip="第二级开关,默认关闭:关闭时修改类命令不下发给模型、硬调也被拒绝;开启后每次修改都会弹 Revit 原生对话框(默认按钮是「否」),单次最多改 200 个构件,数值型(带单位)参数一律不写"/>
                    <TextBlock Text="{Binding AllowModifyText}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#C0392B"/>
                </StackPanel>
                <TextBlock Text="{Binding ToolCountText}" TextWrapping="Wrap" Foreground="#5A5A5A" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#2E7D32" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding ScopeText}" TextWrapping="Wrap" Foreground="#8A8A8A" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- 输入区 -->
        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" Padding="8,6">
            <StackPanel>
                <TextBox x:Name="QuestionBox" Height="52" TextWrapping="Wrap" AcceptsReturn="False"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="例如:统计一下当前模型的构件数量 / 本项目有哪些空间 / 排烟量怎么确定(会先查知识库)"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="发送" Width="80" Height="28" IsDefault="True"
                            Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}"/>
                    <Button Content="清空对话" Width="88" Height="28" Margin="8,0,0,0" Command="{Binding ClearCommand}"/>
                    <Button Content="清空命令日志" Width="110" Height="28" Margin="8,0,0,0" Command="{Binding ClearLogCommand}"/>
                    <TextBlock Text="错误:" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#C0392B"/>
                    <TextBlock Text="{Binding LastError}" VerticalAlignment="Center" Foreground="#C0392B" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 设置区(可收起) -->
        <Expander DockPanel.Dock="Top" Header="服务与密钥设置" Margin="8,6,0,0">
            <StackPanel Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="服务" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ProviderBox" Width="220" Margin="8,0,0,0" VerticalAlignment="Center"
                              ItemsSource="{Binding Providers}" DisplayMemberPath="DisplayText"
                              SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"/>
                    <Button Content="申请 API key" Width="110" Height="24" Margin="8,0,0,0" Command="{Binding OpenKeyPageCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="API key" VerticalAlignment="Center"/>
                    <TextBox x:Name="KeyBox" Width="300" Height="24" Margin="8,0,0,0"
                             Text="{Binding ApiKeyText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按工作区用 Windows DPAPI 加密保存在本机(ai-key.bin),界面不回显已存值以外的内容;请勿把密钥贴进聊天内容"/>
                    <Button Content="保存设置" Width="90" Height="24" Margin="8,0,0,0" Command="{Binding SaveCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="模型" VerticalAlignment="Center"/>
                    <TextBox x:Name="ModelBox" Width="180" Height="24" Margin="8,0,0,0"
                             Text="{Binding ModelText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="以服务方官方文档为准;填错会照实报 422/400"/>
                    <TextBlock Text="接口地址" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox x:Name="EndpointBox" Width="300" Height="24" Margin="8,0,0,0"
                             Text="{Binding EndpointText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="OpenAI 兼容 base 地址(不含 /chat/completions);自建或走代理时才改"/>
                </StackPanel>
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#23486E" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="#8A6100" Margin="0,2,0,0"/>
            </StackPanel>
        </Expander>

        <!-- 聊天记录 + 命令日志 -->
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="160"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Background="#FBFDFF"
                          BorderBrush="#DDDDDD" BorderThickness="1" Padding="6">
                <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock TextWrapping="Wrap" FontWeight="Bold" Foreground="#23486E"
                                           Text="我:" Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock TextWrapping="Wrap" FontWeight="Bold" Foreground="#33691E"
                                           Text="AI 助手(草稿):" Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVis}}"/>
                                <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         Background="Transparent" BorderThickness="0" FontFamily="Consolas"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Visibility="{Binding HasToolLog, Converter={StaticResource BoolToVis}}">
                <TextBlock FontWeight="Bold" Foreground="#23486E" Margin="0,6,0,4"
                           Text="命令活动日志(模型调用了哪条命令、结果如何;命令都在本进程内执行)"/>
                <DataGrid x:Name="ToolGrid" Style="{StaticResource Grid}" ItemsSource="{Binding ToolLog}"
                          MaxHeight="110" AlternatingRowBackground="#F7FAFD">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="命令" Width="240" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="结果" Width="80" Binding="{Binding State}"/>
                        <DataGridTextColumn Header="耗时" Width="90" Binding="{Binding ElapsedText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
